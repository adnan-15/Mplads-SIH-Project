APP_ENV=development
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8000
CORS_ORIGINS=http://localhost:5173
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/mplads_sentinel
UPLOADS_DIR=uploads
PROCESSED_UPLOADS_DIR=processed_uploads
